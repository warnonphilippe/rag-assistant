{
  "name": "rag-assistant",
  "productName": "Assistant RAG",
  "version": "0.1.0",
  "description": "Assistant RAG local : interrogez vos documents et liens, avec citations.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "ng": "ng",
    "build:ui": "ng build --base-href ./",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:ui && npm run build:electron",
    "start": "npm run build && electron .",
    "start:fast": "npm run build:electron && electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "test:models": "npm run build:electron && node tests/models/smoke.mjs",
    "dist": "npm run build && electron-builder --mac dmg",
    "icon": "sh build/make-icon.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "node-llama-cpp": "^3.22.3",
    "pdfjs-dist": "^6.5.438",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@types/node": "^24.0.0",
    "docx": "^9.5.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "pdfkit": "^0.17.0",
    "playwright": "^1.65.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "app.assistant-rag.desktop",
    "productName": "Assistant RAG",
    "copyright": "Assistant RAG",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/rag-assistant/**",
      "dist-electron/main.mjs",
      "dist-electron/preload.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/sqlite-vec/**",
      "node_modules/sqlite-vec-*/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "title": "Assistant RAG",
      "artifactName": "Assistant-RAG-${version}-${arch}.dmg"
    }
  }
}
